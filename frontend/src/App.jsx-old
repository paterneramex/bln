import { useState, useEffect } from 'react';
import { BrowserRouter, Routes, Route, Navigate, useNavigate } from 'react-router-dom';
import api from './api';
import Login from './Login';
import CustomerForm from './components/CustomerForm';
import PoolForm from './components/PoolForm';
import IpsupForm from './components/IpsupForm';
import HbsForm from './components/HbsForm';
import DataTable from './components/DataTable';
import EditModal from './components/EditModal';
import { COLUMNS_BY_TAB } from './utils/columns';
import { trimPayload } from './utils/validators';

const FONT_STACK = "Calibri, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif";

const TAB_LABELS = {
  customers: 'Clients',
  ipsups: 'Ipsups',
  pools: 'Pools',
  hbs: 'Hbs',
};

const TAB_SINGULAR = {
  customers: 'client',
  pools: 'pool',
  ipsups: 'ipsup',
  hbs: 'hb',
};

function Dashboard() {
  const [activeTab, setActiveTab] = useState('customers');
  const [dashboardData, setDashboardData] = useState({ customers: [], ipsups: [], pools: [], hbs: [] });
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);
  const [editingRecord, setEditingRecord] = useState(null); // { table, record }
  // Create panel starts collapsed so the table gets the full width by
  // default — it only takes up space once the user actually asks for it.
  const [showCreatePanel, setShowCreatePanel] = useState(false);
  const navigate = useNavigate();

  const fetchData = () => {
    setLoading(true);
    Promise.all([api.get('customers/'), api.get('ipsups/'), api.get('pools/'), api.get('hbs/')])
      .then(([c, i, p, h]) => {
        setDashboardData({ customers: c.data, ipsups: i.data, pools: p.data, hbs: h.data });
        setError(null);
      })
      .catch((err) => setError(err.response?.data ? JSON.stringify(err.response.data) : err.message))
      .finally(() => setLoading(false));
  };

  useEffect(() => {
    fetchData();
  }, []);

  const handleLogout = () => {
    localStorage.clear();
    navigate('/login');
  };

  // Returns true/false so the calling form knows whether to clear its
  // fields — on failure the form must keep exactly what the user typed
  // (see handleSubmit in each *Form.jsx), so the person doesn't have to
  // retype everything just because one field was rejected.
  const createRecord = async (endpoint, payload) => {
    try {
      await api.post(`${endpoint}/`, trimPayload(payload));
      fetchData();
      return true;
    } catch (err) {
      alert('Failed to provision record: ' + JSON.stringify(err.response?.data || err.message));
      return false;
    }
  };

  const updateRecord = async (endpoint, id, payload) => {
    try {
      await api.patch(`${endpoint}/${id}/`, trimPayload(payload));
      fetchData();
      setEditingRecord(null);
      return true;
    } catch (err) {
      alert('Failed to update record: ' + JSON.stringify(err.response?.data || err.message));
      return false;
    }
  };

  const deleteRecord = async (endpoint, row) => {
    const label = row.srvnewident || row.customer_name || row.pool_code || row.ipsup_name || row.nom_relai || row.id;
    if (!window.confirm(`Delete this record (${label})? This cannot be undone.`)) return;
    try {
      await api.delete(`${endpoint}/${row.id}/`);
      fetchData();
    } catch (err) {
      alert('Failed to delete record: ' + JSON.stringify(err.response?.data || err.message));
    }
  };

  const columns = COLUMNS_BY_TAB[activeTab];

  return (
    // h-screen + overflow-hidden: the PAGE itself never scrolls. Every
    // bar (header, tabs, add button, table toolbar, table header row)
    // is `shrink-0` — fixed size, zero movement. Only the table's own
    // row area (flex-1 min-h-0 below) scrolls, in the leftover space.
    <div className="h-screen overflow-hidden bg-blue-50/40 text-blue-950 flex flex-col" style={{ fontFamily: FONT_STACK }}>
      <header className="shrink-0 h-16 bg-gradient-to-r from-blue-950 via-blue-900 to-blue-800 px-6 flex items-center justify-between shadow-md">
        <div className="flex items-center gap-3">
          <div className="h-9 w-9 rounded-lg bg-white/10 border border-white/20 flex items-center justify-center font-bold text-white shadow-inner">B</div>
          <h1 className="text-xl font-semibold tracking-tight text-white">BLN Enterprise System</h1>
        </div>
        <div className="flex items-center gap-4">
          <button
            onClick={handleLogout}
            className="px-3.5 py-1.5 rounded-lg bg-white/10 hover:bg-rose-500/80 text-blue-100 hover:text-white border border-white/20 text-sm font-medium transition cursor-pointer"
          >
            Fermer la session
          </button>
        </div>
      </header>

      <div className="shrink-0 px-6 pt-4 bg-blue-50/95 flex border-b border-blue-200 gap-1 max-w-[1600px] mx-auto w-full">
        {['customers', 'ipsups', 'pools', 'hbs'].map((tab) => (
          <button
            key={tab}
            onClick={() => setActiveTab(tab)}
            className={`px-4 py-2.5 text-sm font-semibold border-b-2 transition cursor-pointer ${
              activeTab === tab
                ? 'border-blue-600 text-blue-700'
                : 'border-transparent text-blue-400 hover:text-blue-600'
            }`}
          >
            {TAB_LABELS[tab]}
          </button>
        ))}
      </div>

      {/* flex-1 min-h-0: takes exactly the remaining viewport height.
          min-h-0 is what lets a flex child actually shrink instead of
          growing past the viewport and re-introducing page scroll. */}
      <main className="flex-1 min-h-0 flex flex-col p-6 max-w-[1600px] mx-auto w-full gap-4 overflow-hidden">
        {error && (
          <div className="shrink-0 p-4 rounded-xl border border-rose-200 bg-rose-50 text-rose-700 text-sm">{error}</div>
        )}

        {loading ? (
          <div className="text-center py-12 text-blue-400 animate-pulse text-sm">
            Interrogation des jeux de données actifs...
          </div>
        ) : (
          <div className="flex-1 min-h-0 flex flex-col gap-4">
            {/* Toggle bar — fixed size, never moves. */}
            <div className="shrink-0 flex items-center justify-between">
              <button
                onClick={() => setShowCreatePanel((v) => !v)}
                className="flex items-center gap-2 px-4 py-2 rounded-lg bg-blue-700 hover:bg-blue-600 text-white text-sm font-semibold shadow-md transition cursor-pointer"
              >
                <span className="text-base leading-none">{showCreatePanel ? '−' : '+'}</span>
                {showCreatePanel ? 'Masquer le formulaire' : `Ajouter un ${TAB_SINGULAR[activeTab]}`}
              </button>
            </div>

            {/* Create-record panel — mounted permanently (not
                conditionally rendered), same reasoning as the four forms
                inside it: toggling `showCreatePanel` off (the "−"
                button) must only hide the panel, not unmount it and
                wipe out a half-filled form. Scrolls internally (max-h +
                overflow-y-auto) if the form is taller than the space
                left, instead of pushing the page or the table around. */}
            <div
              className="shrink-0 max-h-[45vh] overflow-y-auto border border-blue-200 rounded-2xl bg-white p-5 shadow-lg space-y-4"
              style={{ display: showCreatePanel ? 'block' : 'none' }}
            >
                <h3 className="text-base font-semibold text-blue-900 flex items-center gap-2">
                  🛠️ Moteur de provisionnement
                </h3>
                <p className="text-xs text-blue-500">
                  Les champs se valident en temps réel — inutile de soumettre pour voir une erreur de format ou de doublon.
                </p>

                {/* All four forms are mounted together (not swapped by
                    component type) and only hidden via CSS for the
                    inactive tabs. Swapping which component renders
                    based on activeTab would make React unmount/remount
                    a fresh instance every time — wiping out whatever
                    the user had already typed the moment they switched
                    tabs and came back. Keeping every instance alive for
                    the whole session means a half-filled customer form
                    survives a detour to the ipsups tab, or even
                    collapsing and reopening the panel itself. */}
                <div style={{ display: activeTab === 'customers' ? 'block' : 'none' }}>
                  <CustomerForm
                    existingCustomers={dashboardData.customers}
                    existingIpsups={dashboardData.ipsups}
                    onSubmit={(payload) => createRecord('customers', payload)}
                  />
                </div>
                <div style={{ display: activeTab === 'pools' ? 'block' : 'none' }}>
                  <PoolForm onSubmit={(payload) => createRecord('pools', payload)} />
                </div>
                <div style={{ display: activeTab === 'ipsups' ? 'block' : 'none' }}>
                  <IpsupForm
                    existingCustomers={dashboardData.customers}
                    onSubmit={(payload) => createRecord('ipsups', payload)}
                  />
                </div>
                <div style={{ display: activeTab === 'hbs' ? 'block' : 'none' }}>
                  <HbsForm onSubmit={(payload) => createRecord('hbs', payload)} />
                </div>
            </div>

            {/* Fills whatever space is left; DataTable itself keeps its
                own toolbar/header/pagination fixed and only scrolls
                the row area inside that remaining space. */}
            <div className="flex-1 min-h-0">
              <DataTable
                columns={columns}
                data={dashboardData[activeTab]}
                onEdit={(row) => setEditingRecord({ table: activeTab, record: row })}
                onDelete={(row) => deleteRecord(activeTab, row)}
                emptyLabel={`Aucun enregistrement ${TAB_LABELS[activeTab].toLowerCase()}`}
                exportFileName={activeTab}
              />
            </div>
          </div>
        )}
      </main>

      {editingRecord && (
        <EditModal
          table={editingRecord.table}
          record={editingRecord.record}
          existingCustomers={dashboardData.customers}
          existingIpsups={dashboardData.ipsups}
          onClose={() => setEditingRecord(null)}
          onSubmit={(payload) => updateRecord(editingRecord.table, editingRecord.record.id, payload)}
        />
      )}
    </div>
  );
}

export default function App() {
  const ProtectedRoute = ({ children }) => {
    return localStorage.getItem('access_token') ? children : <Navigate to="/login" replace />;
  };

  return (
    <BrowserRouter>
      <Routes>
        <Route path="/login" element={<Login />} />
        <Route
          path="/"
          element={
            <ProtectedRoute>
              <Dashboard />
            </ProtectedRoute>
          }
        />
        <Route path="*" element={<Navigate to="/" replace />} />
      </Routes>
    </BrowserRouter>
  );
}
